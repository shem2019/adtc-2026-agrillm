# OS
.DS_Store

# llama.cpp source cached on the host for the Docker build
bench/llama.cpp.tar.gz
bench/*.partial
bench/models/
bench/.hfcache/

# Fused / merged intermediate model directories — 3 GB of weights plus an 11 MB
# tokenizer each. All are reproducible from the adapter + base model.
train/fused-*/
train/merged/

# Derived corpus. train/african/ holds the source material and is committed;
# train/data/ is regenerated from it by prepare_data.py in under a minute.
train/data/*.jsonl

# Stray screenshots at repo root
/Screenshot*.png

# LibreOffice lock files left behind while a deck is open
.~lock.*#

# Video production artifacts. Kept locally; they are not part of the
# submission and the template's required structure does not include them.
VIDEO_SCRIPT.md
assets/AgriLLM_slides.*
assets/make_slides.py

# ---------------------------------------------------------------------------
# Quarantined, not deleted. Kept on disk locally as a record; not tracked.
#
# build_perfect_full_corpus.py is a pure string-template engine (174 templating
# call sites, zero LLM calls). It produced 22,300 "rows" that were roughly 700
# underlying answers wrapped in "Ref N:" serial-number prefixes, which scored
# 100% on a naive distinctness check and ~3% on a shape-normalised one. Its
# output is in train/african/_rejected_templated/ (17 MB). Neither is training
# material and neither should appear in a submission repo.
train/african/build_perfect_full_corpus.py
train/african/_rejected_templated/

# Per-row audit output from that same process. Every row reads
# {"verdict": "KEEP", "problems": [], "confidence": 0.98} including rows later
# found to state pesticide doses as fact. It is a rubber stamp, not evidence.
train/african/_audit/

# Scratch generators and temp dirs from the corpus expansion work.
_gen_multiturn.py
_tmp_gen/
train/_tmp/
train/_tmp_gen/
train/_econ_a.jsonl
train/_gen_econ_b.py
train/_gen_econ_rows.py
train/_gen_potato_rows.py

# Stage-1 external corpus: derived from AI71ai/agrillm-train-146k by
# train/pipeline/prepare_stage1_external.py. Regenerable in ~3 minutes, and
# large. The filter script and its manifest are tracked; the output is not.
train/external/
train/pipeline/data-stage1/
