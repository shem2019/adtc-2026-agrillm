# Model weights are downloaded fresh by the evaluator via download_model.sh.
# Committing them is an explicit rule violation.
model/
*.gguf
*.bin
*.safetensors

# Profiler artifacts
submission.json
audit.json
verdict.json
bench/results/

# Training scratch
data/raw/
data/interim/
outputs/
checkpoints/
*.lora
wandb/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.uv-cache/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# llama.cpp source cached on the host for the Docker build
bench/llama.cpp.tar.gz
bench/*.partial
bench/models/
bench/.hfcache/

# Fused / merged intermediate model directories — 3 GB of weights plus an 11 MB
# tokenizer each. All are reproducible from the adapter + base model.
train/fused-*/
train/merged/

# Derived corpus. train/african/ holds the source material and is committed;
# train/data/ is regenerated from it by prepare_data.py in under a minute.
train/data/*.jsonl

# Stray screenshots at repo root
/Screenshot*.png

# LibreOffice lock files left behind while a deck is open
.~lock.*#

# Video production artifacts. Kept locally; they are not part of the
# submission and the template's required structure does not include them.
VIDEO_SCRIPT.md
assets/AgriLLM_slides.*
assets/make_slides.py
